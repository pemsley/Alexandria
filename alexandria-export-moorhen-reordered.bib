@article{Emsley:Coot:2010,
  title    = {Features and development of Coot},
  author   = {Emsley, Paul and Lohkamp, Bernhard and Scott, W. G. and Cowtan, Kevin},
  year     = {2010},
  journal  = {Acta Crystallographica Section D},
  doi      = {10.1107/S0907444910007493},
  abstract = {Coot is a molecular-graphics application for model building and validation of biological macromolecules. The program displays electron-density maps and atomic models and allows model manipulations such as idealization, real-space refinement, manual rotation/translation, rigid-body fitting, ligand search, solvation, mutations, rotamers and Ramachandran idealization. Furthermore, tools are provided for model validation as well as interfaces to external programs for refinement, validation and graphics. The software is designed to be easy to learn for novice users, which is achieved by ensuring that tools for common tasks are `discoverable' through familiar user-interface elements (menus and toolbars) or by intuitive behaviour (mouse controls). Recent developments have focused on providing tools for expert users, with customisable key bindings, extensions and an extensive scripting interface. The software is under rapid development, but has already achieved very widespread use within the crystallographic community. The current state of the software is presented, with a description of the facilities available and of some of the underlying methods employed.},
  keywords = {Coot, model building},
  month    = {Apr},
  number   = {4},
  pages    = {486--501},
  url      = {https://doi.org/10.1107/S0907444910007493},
  volume   = {66}
}

@article{Agirre:CCP4:2023,
  title    = {The CCP4 suite: integrative software for macromolecular crystallography},
  author   = {Agirre, Jon and Atanasova, Mihaela and Bagdonas, Haroldas and Ballard, Charles B. and Baslé, Arnaud and Beilsten‐Edmands, James and Borges, Rafael J. and Brown, D. and Burgos-Mármol, J. Javier and Berrisford, John M. and Bond, Paul S. and Caballero, Iracema and Catapano, Lucrezia and Chojnowski, Grzegorz and Cook, Atlanta G. and Cowtan, Kevin and Croll, Tristan I. and Debreczeni, J.E. and Devenish, N. E. and Dodson, E.J. and Drevon, Tarik R. and Emsley, Paul and Evans, Gwyndaf and Evans, Phil and Fando, Maria and Foadi, James and Fuentes‐Montero, Luis and Garman, Elspeth F. and Gerstel, Markus and Gildea, Richard J. and Hatti, Kaushik and Hekkelman, Maarten L. and Heuser, Philipp and Hoh, Soon Wen and Hough, Michael A. and Jenkins, Huw T. and Jiménez, Elisabet and Joosten, Robbie P. and Keegan, Ronan M. and Keep, N.H. and Krissinel, Eugene and Kolenko, Petr and Kovalevskiy, Oleg and Lamzin, Victor S. and Lawson, David M. and Lebedev, Andrey A. and Leslie, Andrew G. W. and Lohkamp, Bernhard and Long, Fei and Malý, Martin and McCoy, Airlie J. and McNicholas, Stuart and Medina, Ana and Millán, Claudia and Murray, James W. and Murshudov, Garib N. and Nicholls, Robert A. and Noble, M.E.M. and Oeffner, Robert D. and Pannu, Navraj S. and Parkhurst, James M. and Pearce, Nicholas M. and Pereira, Joana and Perrakis, Anastassis and Powell, Harold R. and Read, Randy J. and Rigden, Daniel J. and Rochira, William and Sammito, Massimo and Rodríguez, Filomeno Sánchez and Sheldrick, George M. and Shelley, Kathryn L. and Šimkovic, Felix and Simpkin, Adam J. and Skubák, Pavol and Sobolev, E. V. and Steiner, Roberto A. and Stevenson, Kyle and Tews, Ivo and Thomas, Jens M. H. and Thorn, Andrea and Triviño, Josep and Uski, Ville and Usón, Isabel and Vagin, Alexei A. and Velankar, Sameer and Vollmar, M. and Walden, Helen and Waterman, David G. and Wilson, Keith S. and Winn, Martyn and Winter, Graeme and Wojdyr, Marcin and Yamashita, Keitaro},
  year     = {2023},
  journal  = {Acta Crystallographica Section D},
  doi      = {10.1107/S2059798323003595},
  abstract = {The Collaborative Computational Project No. 4 (CCP4) is a UK-led international collective with a mission to develop, test, distribute and promote software for macromolecular crystallography. The CCP4 suite is a multiplatform collection of programs brought together by familiar execution routines, a set of common libraries and graphical interfaces. The CCP4 suite has experienced several considerable changes since its last reference article, involving new infrastructure, original programs and graphical interfaces. This article, which is intended as a general literature citation for the use of the CCP4 software suite in structure determination, will guide the reader through such transformations, offering a general overview of the new features and outlining future developments. As such, it aims to highlight the individual programs that comprise the suite and to provide the latest references to them for perusal by crystallographers around the world.},
  keywords = {Collaborative Computational Project No. 4, CCP4, crystallography software, macromolecular crystallography},
  month    = {Jun},
  number   = {6},
  pages    = {449--461},
  url      = {https://doi.org/10.1107/S2059798323003595},
  volume   = {79}
}

@article{McNicholas:CCP4MG:2011,
  title    = {Presenting your structures: the CCP4mg molecular-graphics software},
  author   = {McNicholas, Stuart and Potterton, Elizabeth and Wilson, Keith S. and Noble, M.E.M.},
  year     = {2011},
  journal  = {Acta Crystallographica Section D},
  doi      = {10.1107/S0907444911007281},
  abstract = {CCP4mg is a molecular-graphics program that is designed to give rapid access to both straightforward and complex static and dynamic representations of macromolecular structures. It has recently been updated with a new interface that provides more sophisticated atom-selection options and a wizard to facilitate the generation of complex scenes. These scenes may contain a mixture of coordinate-derived and abstract graphical objects, including text objects, arbitrary vectors, geometric objects and imported images, which can enhance a picture and eliminate the need for subsequent editing. Scene descriptions can be saved to file and transferred to other molecules. Here, the substantially enhanced version 2 of the program, with a new underlying GUI toolkit, is described. A built-in rendering module produces publication-quality images.},
  keywords = {CCP4mg, molecular graphics, movies, crystallographic software},
  month    = {Apr},
  number   = {4},
  pages    = {386--394},
  url      = {https://doi.org/10.1107/S0907444911007281},
  volume   = {67}
}

