@article{Long:ba5260,
author = "Long, Fei and Nicholls, Robert A. and Emsley, Paul and Gra{\v{z}}ulis, Saulius and Merkys, Andrius and Vaitkus, Antanas and Murshudov, Garib N.",
title = "{{\it AceDRG}: a stereochemical description generator for ligands}",
journal = "Acta Crystallographica Section D",
year = "2017",
volume = "73",
number = "2",
pages = "112--122",
month = "Feb",
doi = {10.1107/S2059798317000067},
url = {https://doi.org/10.1107/S2059798317000067},
abstract = {The program {\it AceDRG} is designed for the derivation of stereochemical information about small molecules. It uses local chemical and topological environment-based atom typing to derive and organize bond lengths and angles from a small-molecule database: the Crystallography Open Database (COD). Information about the hybridization states of atoms, whether they belong to small rings (up to seven-membered rings), ring aromaticity and nearest-neighbour information is encoded in the atom types. All atoms from the COD have been classified according to the generated atom types. All bonds and angles have also been classified according to the atom types and, in a certain sense, bond types. Derived data are tabulated in a machine-readable form that is freely available from {\it CCP}4. {\it AceDRG} can also generate stereochemical information, provided that the basic bonding pattern of a ligand is known. The basic bonding pattern is perceived from one of the computational chemistry file formats, including SMILES, mmCIF, SDF MOL and SYBYL MOL2 files. Using the bonding chemistry, atom types, and bond and angle tables generated from the COD, {\it AceDRG} derives the `ideal' bond lengths, angles, plane groups, aromatic rings and chirality information, and writes them to an mmCIF file that can be used by the refinement program {\it REFMAC}5 and the model-building program {\it Coot}. Other refinement and model-building programs such as {\it PHENIX} and {\it BUSTER} can also use these files. {\it AceDRG} also generates one or more coordinate sets corresponding to the most favourable conformation(s) of a given ligand. {\it AceDRG} employs {\it RDKit} for chemistry perception and for initial conformation generation, as well as for the interpretation of SMILES strings, SDF MOL and SYBYL MOL2 files.},
keywords = {AceDRG, refinement, ligand chemistry, Crystallography Open Database, RDKit},
}

