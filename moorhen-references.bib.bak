@Article{VHELIBS,
author="Cereto-Massagu{\'e}, Adri{\`a}
and Ojeda, Mar{\'i}a Jos{\'e}
and Joosten, Robbie P.
and Valls, Cristina
and Mulero, Miquel
and Salvado, M. Josepa
and Arola-Arnal, Anna
and Arola, Llu{\'i}s
and Garcia-Vallv{\'e}, Santiago
and Pujadas, Gerard",
title="The good, the bad and the dubious: VHELIBS, a validation helper for ligands and binding sites",
journal="Journal of Cheminformatics",
year="2013",
volume="5",
number="1",
pages="1--9",
abstract="Many Protein Data Bank (PDB) users assume that the deposited structural models are of high quality but forget that these models are derived from the interpretation of experimental data. The accuracy of atom coordinates is not homogeneous between models or throughout the same model. To avoid basing a research project on a flawed model, we present a tool for assessing the quality of ligands and binding sites in crystallographic models from the PDB.",
issn="1758-2946",
doi="10.1186/1758-2946-5-36",
url="http://dx.doi.org/10.1186/1758-2946-5-36"
}

@article{Krissinel:CCP4Cloud,
author = "Krissinel, Eugene and Lebedev, Andrey A. and Uski, Ville and Ballard, Charles B. and Keegan, Ronan M. and Kovalevskiy, Oleg and Nicholls, Robert A. and Pannu, Navraj S. and Skub{\'{a}}k, Pavol and Berrisford, John and Fando, Maria and Lohkamp, Bernhard and Wojdyr, Marcin and Simpkin, Adam J. and Thomas, Jens M. H. and Oliver, Christopher and Vonrhein, Clemens and Chojnowski, Grzegorz and Basle, Arnaud and Purkiss, Andrew and Isupov, Michail N. and McNicholas, Stuart and Lowe, Edward and Trivi{\~{n}}o, Josep and Cowtan, Kevin and Agirre, Jon and Rigden, Daniel J. and Uson, Isabel and Lamzin, Victor and Tews, Ivo and Bricogne, Gerard and Leslie, Andrew G. W. and Brown, David G.",
title = "{{\it CCP}4 Cloud for structure determination and project management in macromolecular crystallography}",
journal = "Acta Crystallographica Section D",
year = "2022",
volume = "78",
number = "9",
pages = "1079--1089",
month = "Sep",
doi = {10.1107/S2059798322007987},
url = {https://doi.org/10.1107/S2059798322007987},
abstract = {Nowadays, progress in the determination of three-dimensional macromolecular structures from diffraction images is achieved partly at the cost of increasing data volumes. This is due to the deployment of modern high-speed, high-resolution detectors, the increased complexity and variety of crystallographic software, the use of extensive databases and high-performance computing. This limits what can be accomplished with personal, offline, computing equipment in terms of both productivity and maintainability. There is also an issue of long-term data maintenance and availability of structure-solution projects as the links between experimental observations and the final results deposited in the PDB. In this article, {\it CCP}4 Cloud, a new front-end of the {\it CCP}4 software suite, is presented which mitigates these effects by providing an online, cloud-based environment for crystallographic computation. {\it CCP}4 Cloud was developed for the efficient delivery of computing power, database services and seamless integration with web resources. It provides a rich graphical user interface that allows project sharing and long-term storage for structure-solution projects, and can be linked to data-producing facilities. The system is distributed with the {\it CCP}4 software suite version 7.1 and higher, and an online publicly available instance of {\it CCP}4 Cloud is provided by CCP4.},
keywords = {CCP4, CCP4 Cloud, macromolecular crystallography, distributed computing, data management, project management},
}

