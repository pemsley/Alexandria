@article{Emsley:Coot:2010,
author = "Emsley, P. and Lohkamp, B. and Scott, W. G. and Cowtan, K.",
title = "{Features and development of {\it Coot}}",
journal = "Acta Crystallographica Section D",
year = "2010",
volume = "66",
number = "4",
pages = "486--501",
month = "Apr",
doi = {10.1107/S0907444910007493},
url = {https://doi.org/10.1107/S0907444910007493},
abstract = {{\it Coot} is a molecular-graphics application for model building and validation of biological macromolecules. The program displays electron-density maps and atomic models and allows model manipulations such as idealization, real-space refinement, manual rotation/translation, rigid-body fitting, ligand search, solvation, mutations, rotamers and Ramachandran idealization. Furthermore, tools are provided for model validation as well as interfaces to external programs for refinement, validation and graphics. The software is designed to be easy to learn for novice users, which is achieved by ensuring that tools for common tasks are `discoverable' through familiar user-interface elements (menus and toolbars) or by intuitive behaviour (mouse controls). Recent developments have focused on providing tools for expert users, with~customisable key bindings, extensions and an extensive scripting interface. The software is under rapid development, but has already achieved very widespread use within the crystallographic community. The current state of the software is presented, with a description of the facilities available and of some of the underlying methods employed.},
keywords = {Coot, model building},
}

@article{Agirre:CCP4:2023,
author = "Agirre, Jon and Atanasova, Mihaela and Bagdonas, Haroldas and Ballard, Charles B. and Basl{\'{e}}, Arnaud and Beilsten-Edmands, James and Borges, Rafael J. and Brown, David G. and Burgos-M{\'{a}}rmol, J. Javier and Berrisford, John M. and Bond, Paul S. and Caballero, Iracema and Catapano, Lucrezia and Chojnowski, Grzegorz and Cook, Atlanta G. and Cowtan, Kevin D. and Croll, Tristan I. and Debreczeni, Judit {\'{E}}. and Devenish, Nicholas E. and Dodson, Eleanor J. and Drevon, Tarik R. and Emsley, Paul and Evans, Gwyndaf and Evans, Phil R. and Fando, Maria and Foadi, James and Fuentes-Montero, Luis and Garman, Elspeth F. and Gerstel, Markus and Gildea, Richard J. and Hatti, Kaushik and Hekkelman, Maarten L. and Heuser, Philipp and Hoh, Soon Wen and Hough, Michael A. and Jenkins, Huw T. and Jim{\'{e}}nez, Elisabet and Joosten, Robbie P. and Keegan, Ronan M. and Keep, Nicholas and Krissinel, Eugene B. and Kolenko, Petr and Kovalevskiy, Oleg and Lamzin, Victor S. and Lawson, David M. and Lebedev, Andrey A. and Leslie, Andrew G. W. and Lohkamp, Bernhard and Long, Fei and Mal{\'{y}}, Martin and McCoy, Airlie J. and McNicholas, Stuart J. and Medina, Ana and Mill{\'{a}}n, Claudia and Murray, James W. and Murshudov, Garib N. and Nicholls, Robert A. and Noble, Martin E. M. and Oeffner, Robert and Pannu, Navraj S. and Parkhurst, James M. and Pearce, Nicholas and Pereira, Joana and Perrakis, Anastassis and Powell, Harold R. and Read, Randy J. and Rigden, Daniel J. and Rochira, William and Sammito, Massimo and S{\'{a}}nchez Rodr{\'\i}guez, Filomeno and Sheldrick, George M. and Shelley, Kathryn L. and Simkovic, Felix and Simpkin, Adam J. and Skubak, Pavol and Sobolev, Egor and Steiner, Roberto A. and Stevenson, Kyle and Tews, Ivo and Thomas, Jens M. H. and Thorn, Andrea and Valls, Josep Trivi{\~{n}}o and Uski, Ville and Us{\'{o}}n, Isabel and Vagin, Alexei and Velankar, Sameer and Vollmar, Melanie and Walden, Helen and Waterman, David and Wilson, Keith S. and Winn, Martyn D. and Winter, Graeme and Wojdyr, Marcin and Yamashita, Keitaro",
title = "{The {\it CCP}4 suite: integrative software for macromolecular crystallography}",
journal = "Acta Crystallographica Section D",
year = "2023",
volume = "79",
number = "6",
pages = "449--461",
month = "Jun",
doi = {10.1107/S2059798323003595},
url = {https://doi.org/10.1107/S2059798323003595},
abstract = {The Collaborative Computational Project No. 4 (CCP4) is a UK-led international collective with a mission to develop, test, distribute and promote software for macromolecular crystallography. The {\it CCP}4 suite is a multiplatform collection of programs brought together by familiar execution routines, a set of common libraries and graphical interfaces. The {\it CCP}4 suite has experienced several considerable changes since its last reference article, involving new infrastructure, original programs and graphical interfaces. This article, which is intended as a general literature citation for the use of the {\it CCP}4 software suite in~structure determination, will guide the reader through such transformations, offering a general overview of the new features and outlining future developments. As such, it aims to highlight the individual programs that comprise the suite and to provide the latest references to them for perusal by crystallographers around the world.},
keywords = {Collaborative Computational Project No. 4, CCP4, crystallography software, macromolecular crystallography},
}

@article{McNicholas:CCP4MG:2011,
author = "McNicholas, S. and Potterton, E. and Wilson, K. S. and Noble, M. E. M.",
title = "{Presenting your structures: the {\it CCP}4{\it mg} molecular-graphics software}",
journal = "Acta Crystallographica Section D",
year = "2011",
volume = "67",
number = "4",
pages = "386--394",
month = "Apr",
doi = {10.1107/S0907444911007281},
url = {https://doi.org/10.1107/S0907444911007281},
abstract = {{\it CCP}4{\it mg} is a molecular-graphics program that is designed to give rapid access to both straightforward and complex static and dynamic representations of macromolecular structures. It has recently been updated with a new interface that provides more sophisticated atom-selection options and a wizard to facilitate the generation of complex scenes. These scenes may contain a mixture of coordinate-derived and abstract graphical objects, including text objects, arbitrary vectors, geometric objects and imported images, which can enhance a picture and eliminate the need for subsequent editing. Scene descriptions can be saved to file and transferred to other molecules. Here, the substantially enhanced version 2 of the program, with a new underlying GUI toolkit, is described. A built-in rendering module produces publication-quality images.},
keywords = {CCP4mg, molecular graphics, movies, crystallographic software},
}

