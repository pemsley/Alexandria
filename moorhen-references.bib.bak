@article{Winn:dz5219,
author = "Winn, Martyn D. and Ballard, Charles C. and Cowtan, Kevin D. and Dodson, Eleanor J. and Emsley, Paul and Evans, Phil R. and Keegan, Ronan M. and Krissinel, Eugene B. and Leslie, Andrew G. W. and McCoy, Airlie and McNicholas, Stuart J. and Murshudov, Garib N. and Pannu, Navraj S. and Potterton, Elizabeth A. and Powell, Harold R. and Read, Randy J. and Vagin, Alexei and Wilson, Keith S.",
title = "{Overview of the {\it CCP}4 suite and current developments}",
journal = "Acta Crystallographica Section D",
year = "2011",
volume = "67",
number = "4",
pages = "235--242",
month = "Apr",
doi = {10.1107/S0907444910045749},
url = {https://doi.org/10.1107/S0907444910045749},
abstract = {The {\it CCP}4 (Collaborative Computational Project, Number 4) software suite is a collection of programs and associated data and software libraries which can be used for macromolecular structure determination by X-ray crystallography. The suite is designed to be flexible, allowing users a number of methods of~achieving their aims. The programs are from a wide variety of~sources but are connected by a common infrastructure provided by standard file formats, data objects and graphical interfaces. Structure solution by macromolecular crystallo{\-}graphy is becoming increasingly automated and the {\it CCP}4 suite includes several automation pipelines. After giving a brief description of the evolution of {\it CCP}4 over the last 30 years, an overview of the current suite is given. While detailed descriptions are given in the accompanying articles, here it is shown how the individual programs contribute to a complete software package.},
keywords = {CCP4, macromolecular crystallography, software, collaboration, automation, macromolecular structure determination},
}

@article{Simpkin:qe5007,
author = "Simpkin, Adam J. and Elliot, Luc G. and Joseph, Agnel Praveen and Burnley, Tom and Stevenson, Kyle and S{\'{a}}nchez Rodr{\'\i}guez, Filomeno and Fando, Maria and Krissinel, Eugene and McNicholas, Stuart and Rigden, Daniel J. and Keegan, Ronan M.",
title = "{{\it Slice'N'Dice}: maximizing the value of predicted models for structural biologists}",
journal = "Acta Crystallographica Section D",
year = "2025",
volume = "81",
number = "3",
pages = "105--121",
month = "Mar",
doi = {10.1107/S2059798325001251},
url = {https://doi.org/10.1107/S2059798325001251},
abstract = {With the advent of next-generation modelling methods, such as {\it AlphaFold}2, structural biologists are increasingly using predicted structures to obtain structure solutions via molecular replacement (MR) or model fitting in single-particle cryogenic sample electron microscopy (cryoEM). Differences between the domain{--}domain orientations represented in a predicted model and a crystal structure are often a key limitation when using predicted models. {\it Slice'N'Dice} is a software package designed to address this issue by first slicing models into distinct structural units and then automatically placing the slices using either {\it Phaser}, {\it MOLREP} or {\it PowerFit}. The slicing step can use the {\it AlphaFold} predicted aligned error (PAE) or can operate via a variety of C${\sp\alpha}$-atom-based clustering algorithms, extending the applicability to structures of any origin. The number of splits can either be selected by the user or determined automatically. {\it Slice'N'Dice} is available for both MR and automated map fitting in the {\it CCP}4 and {\it CCP-EM} software suites.},
keywords = {structure determination, cryo-EM, X-ray crystallography, molecular replacement, structure prediction},
}

@article{Dialpuri:qe5003,
author = "Dialpuri, Jordan S. and Bagdonas, Haroldas and Atanasova, Mihaela and Schofield, Lucy C. and Hekkelman, Maarten L. and Joosten, Robbie P. and Agirre, Jon",
title = "{Analysis and validation of overall {\it N}-glycan conformation in {\it Privateer}}",
journal = "Acta Crystallographica Section D",
year = "2023",
volume = "79",
number = "6",
pages = "462--472",
month = "Jun",
doi = {10.1107/S2059798323003510},
url = {https://doi.org/10.1107/S2059798323003510},
abstract = {The oligosaccharides in {\it N}-glycosylation provide key structural and functional contributions to a glycoprotein. These contributions are dependent on the composition and overall conformation of the glycans. The {\it Privateer} software allows structural biologists to evaluate and improve the atomic structures of carbohydrates, including {\it N}-glycans; this software has recently been extended to check glycan composition through the use of glycomics data. Here, a broadening of the scope of the software to analyse and validate the overall conformation of {\it N}-glycans is presented, focusing on a newly compiled set of glycosidic linkage torsional preferences harvested from a curated set of glycoprotein models.},
keywords = {glycobiology, validation, Privateer, N-glycans, torsion angles},
}

